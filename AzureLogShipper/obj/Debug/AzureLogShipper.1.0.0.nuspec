<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>AzureLogShipper</id>
    <version>1.0.0</version>
    <authors>Ashish Kapoor</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <readme>README.md</readme>
    <projectUrl>https://github.com/ashishkapoor2000/AzureLogShipper</projectUrl>
    <description>A lightweight Azure Log Analytics client for shipping structured logs to custom tables. Supports both Workspace Key (HMAC) and Azure AD (Entra ID) authentication. Bring your own log model or use the built-in MonitoringLog.</description>
    <tags>azure loganalytics monitoring logging nuget log-shipper</tags>
    <repository type="git" url="https://github.com/ashishkapoor2000/AzureLogShipper" />
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="Azure.Identity" version="1.13.2" exclude="Build,Analyzers" />
        <dependency id="System.Text.Json" version="9.0.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="C:\Repos\Personal\AzureLogShipper\AzureLogShipper\bin\Debug\net8.0\AzureLogShipper.dll" target="lib\net8.0\AzureLogShipper.dll" />
    <file src="C:\Repos\Personal\AzureLogShipper\AzureLogShipper\README.md" target="\README.md" />
  </files>
</package>